#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# kvantos-mode — управление режимом системы KvantOS (AUR / Nix).
# Режим хранится в /etc/kvantos/mode. Если файла нет, режим
# определяется автоматически: установлен nix → nix, иначе aur.
set -euo pipefail

MODE_FILE=/etc/kvantos/mode
SKEL_DIR=/etc/skel/kvantos
FLAKE_DIR=${FLAKE_DIR:-$HOME/kvantos-nix}

detect_mode() {
    if [ -f "$MODE_FILE" ]; then
        cat "$MODE_FILE"
    elif command -v nix >/dev/null 2>&1; then
        echo nix
    else
        echo aur
    fi
}

cmd_status() {
    local mode
    mode=$(detect_mode)
    if [ -d /run/archiso ]; then
        echo "live (установщик; в установленной системе: $mode)"
    else
        echo "$mode"
    fi
}

cmd_use() {
    local target=${1:-}
    case "$target" in
        nix)
            if ! command -v nix >/dev/null 2>&1; then
                echo "nix не установлен. Ставлю: sudo pacman -S --needed nix git" >&2
                sudo pacman -S --needed --noconfirm nix git
            fi
            if [ ! -d "$FLAKE_DIR" ]; then
                mkdir -p "$FLAKE_DIR"
                if [ -f "$SKEL_DIR/flake.nix" ]; then
                    cp "$SKEL_DIR/flake.nix" "$SKEL_DIR/home.nix" "$FLAKE_DIR/"
                else
                    # fallback: шаблоны встроены в скрипт (нет /etc/skel/kvantos)
                    cat > "$FLAKE_DIR/flake.nix" << 'TEMPLATE'
{
  description = "KvantOS home environment (home-manager)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { nixpkgs, home-manager, ... }:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};
    in {
      homeConfigurations."@USER@" = home-manager.lib.homeManagerConfiguration {
        inherit pkgs;
        modules = [ ./home.nix ];
      };
    };
}
TEMPLATE
                    cat > "$FLAKE_DIR/home.nix" << 'TEMPLATE'
{ config, pkgs, ... }:

{
  home.username = "@USER@";
  home.homeDirectory = "@HOME@";
  home.stateVersion = "24.11";

  # Профиль обучения программированию (KvantOS).
  home.packages = with pkgs; [
    vscodium
    rustup
    jupyterlab
    git
  ];

  programs.git = {
    enable = true;
    userName = "@USER@";
    # userEmail = "you@example.com";
  };

  programs.home-manager.enable = true;
}
TEMPLATE
                fi
                sed -i "s/@USER@/$USER/g; s|@HOME@|$HOME|g" "$FLAKE_DIR/flake.nix" "$FLAKE_DIR/home.nix"
                mkdir -p "$HOME/.config/nix"
                grep -q experimental-features "$HOME/.config/nix/nix.conf" 2>/dev/null || \
                    printf 'experimental-features = nix-command flakes\n' >> "$HOME/.config/nix/nix.conf"
                echo "Шаблоны инициализированы в $FLAKE_DIR"
            fi
            echo nix | sudo tee "$MODE_FILE" >/dev/null
            echo "Режим: nix. Применить окружение: nix run home-manager/master -- switch --flake $FLAKE_DIR#$(whoami)"
            ;;
        aur)
            echo aur | sudo tee "$MODE_FILE" >/dev/null
            echo "Режим: aur (pacman + AUR-хелпер)"
            ;;
        *)
            echo "Использование: kvantos-mode use {nix|aur}" >&2
            exit 2
            ;;
    esac
}

cmd_gc() {
    if command -v nix-store >/dev/null 2>&1; then
        nix-collect-garbage -d
        nix-store --optimise
    else
        echo "nix не установлен — нечего чистить" >&2
        exit 1
    fi
}

case "${1:-status}" in
    status) cmd_status ;;
    use)    cmd_use "${2:-}" ;;
    gc)     cmd_gc ;;
    *) echo "kvantos-mode: status | use nix | use aur | gc" >&2; exit 2 ;;
esac
